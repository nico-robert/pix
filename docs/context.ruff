  # The translation is by the given *(x, y)* vector in the current
  # coordinate system.
  #
  # This is the same:
  #```
  # ctx.transform = ctx.transform.translate(vec2(x, y))
  # # or:
  # ctx.transform = ctx.transform * Mat3.translation(vec2(x, y))
  #```
  #
  # Returns: Nothing.
}
